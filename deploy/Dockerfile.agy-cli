# Analy2API 单账号真实 AntiGravity CLI (agy) 隔离容器镜像
# 每个容器仅挂载单个账号凭证目录与独立出口代理，以 `analy2api agy-bridge` 对外提供标准 /v1 接口。
FROM debian:bookworm-slim

LABEL io.analy2api.image.rev="v1.2.5-agy-cli"

ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG ALL_PROXY=""

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl git tar coreutils sed && \
    rm -rf /var/lib/apt/lists/*

# 安装官方 Linux 版 agy CLI 至 /usr/local/bin/agy 并强校验可执行性
RUN curl --retry 3 --connect-timeout 15 -fsSL https://antigravity.google/cli/install.sh | bash -s -- --dir /usr/local/bin && \
    chmod 0755 /usr/local/bin/agy && \
    /usr/local/bin/agy --version

ENV PATH="/usr/local/bin:/root/.local/bin:/root/.antigravity/bin:${PATH}"

COPY analy2api-linux-amd64 /usr/local/bin/analy2api
RUN chmod +x /usr/local/bin/analy2api && ln -sf /usr/local/bin/analy2api /usr/local/bin/cmdwb2api && \
    mkdir -p /app/auths/.gemini/antigravity/conversations /app/auths/.gemini/antigravity-cli /app/auths/.config/gcloud

ENV AGY_SINGLE_CLIENT=1
ENV AGY_CLI_FORCE_FILE_TOKEN_STORAGE=1
ENV AGY_CLI_DISABLE_AUTO_UPDATE=true
ENV AGY_DISABLE_AUTO_UPDATE=1
ENV AGY_SESSION_RETENTION=stateless
ENV AGY_PROMPT_MODE=default_intercept_continue
ENV AGY_BRIDGE_ADDR=:8317
ENV AGY_AUTH_DIR=/app/auths

EXPOSE 8317
ENTRYPOINT ["/usr/local/bin/analy2api", "agy-bridge"]
