# Analy2API — Single Isolated Real AntiGravity CLI (`agy`) Client Container Image
# 1 Container = 1 Real `agy` CLI client = 1 Proxy IP = 1 Device Fingerprint = 1 Account
#
# Build example (after compiling analy2api-linux-amd64):
#   docker build -f deploy/Dockerfile.agy-cli -t analy2api-agy-cli:latest .
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install official Google Antigravity CLI (`agy`) inside the container (with automatic binary promotion to /usr/local/bin)
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash \
    && if [ -f /root/.local/bin/agy ]; then cp /root/.local/bin/agy /usr/local/bin/agy && chmod 0755 /usr/local/bin/agy; fi \
    || true
ENV PATH="/usr/local/bin:/root/.local/bin:/root/.antigravity/bin:${PATH}"

# Copy Analy2API binary (provides the `analy2api agy-bridge` single-client HTTP bridge + HTTP/2 v1internal fallback)
COPY analy2api-linux-amd64 /usr/local/bin/analy2api
RUN chmod +x /usr/local/bin/analy2api && ln -sf /usr/local/bin/analy2api /usr/local/bin/cmdwb2api

ENV AGY_SINGLE_CLIENT=1
ENV AGY_CLI_DISABLE_AUTO_UPDATE=true
ENV AGY_DISABLE_AUTO_UPDATE=1
ENV AGY_SESSION_RETENTION=stateless
ENV AGY_PROMPT_MODE=default_intercept_continue
ENV AGY_BRIDGE_ADDR=:8317
ENV AGY_AUTH_DIR=/app/auths

EXPOSE 8317

ENTRYPOINT ["/usr/local/bin/analy2api", "agy-bridge"]
