# Analy2API 一体化部署配置（SQLite 零配置默认开箱；如需 PostgreSQL 可配置 DB_PASSWORD）
#
# 用法：
#   cp .env.example .env
#   # 按需修改端口、管理员密码或上游代理
#   ./analy2api                 # 单二进制直接启动（默认 SQLite）
#   # 或 docker compose up -d   # Docker + PostgreSQL 部署

# ---------- 基础运行配置 ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GIN_MODE=release
TZ=Asia/Shanghai
LOG_LEVEL=info
DATA_DIR=./data

# 初始管理员凭证（仅在库里尚无管理员时生效；进入后台后可在右上角随时修改）
BOOTSTRAP_ADMIN_EMAIL=admin@analy2api.local
BOOTSTRAP_ADMIN_PASSWORD=admin123456

# 可选：静态管理 API Key（adm- 前缀，便于脚本自动化运维）
ADMIN_API_KEY=

# ---------- 密钥（留空时单机模式自动生成并持久化至 DATA_DIR/.secrets.json）----------
# Docker + PostgreSQL 部署建议显式固定：
#   openssl rand -hex 24  -> JWT_SECRET / DB_PASSWORD
#   openssl rand -hex 32  -> ENCRYPTION_KEY (64位十六进制)
JWT_SECRET=
JWT_TTL=24h
ENCRYPTION_KEY=

# ---------- 数据库（留空 DB_PASSWORD 默认使用零依赖 SQLite: ./data/analy2api.db）----------
DB_DRIVER=sqlite
DB_SQLITE_PATH=./data/analy2api.db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=analy2api
DB_PASSWORD=
DB_NAME=analy2api
DB_SSLMODE=disable

# 对外反代域名（可选，留空自动按请求 Host / X-Forwarded-Proto 推导）
PUBLIC_BASE_URL=

# ---------- AntiGravity (AGY) 单账号独立容器反代配置 ----------
# 内置单账号真实 agy CLI 镜像（空服务器无本地 agy 时自动构建拉起）
AGY_DOCKER_IMAGE=analy2api-agy-cli:latest
AGY_DATA_DIR=./data/antigravity

# 会话磁盘保留策略：
#   stateless（默认）：反代零磁盘残留，每轮请求结束立即删除 agy .db / brain 目录
#   ephemeral：短期按 session_id 复用 agy si，驱逐/过期/删除时自动清理磁盘
AGY_SESSION_RETENTION=stateless

# 提示词混合策略：
#   blend_clean（默认）：净化版 AGY 原生底本（剔除 artifacts/slash_commands/skills/宿主路径等误导段）+ 后接下游系统提示词
#   verbatim_only：仅原样透传下游提示词
#   native_raw：保留原始原生底本后接下游提示词
AGY_PROMPT_BLEND_MODE=blend_clean
AGY_NATIVE_PROMPT=

# 可选：AntiGravity Google Desktop OAuth client_secret（留空时仅使用 PKCE，或直接用 auth_json / 远程补号导入）
ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# ---------- 上游代理与分级超时 ----------
CC_API_BASE=https://api.commandcode.ai
CC_UPSTREAM_PROXY=
CC_FIRST_TOKEN_TIMEOUT=300s
CC_STREAM_IDLE=180s
CC_NONSTREAM_IDLE=600s
CC_MAX_BODY_MB=100

# ---------- 账号健康检查 ----------
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=10m
HEALTH_FAILURE_THRESHOLD=5
